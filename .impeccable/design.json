      "fluentAccents": {
        "darkDefault": "{colors.dark-fluent-accent}",
        "lightDefault": "{colors.light-native-accent}",
        "matrixDefault": "NativeAppearance.ControlAccent({colors.matrix-native-accent})",
        "custom": "NativeAppearance.ControlAccent(selectedRGB)",
        "nativeAccentIsSeparate": true
      },
      "customAccentPolicy": {
        "format": "Opaque #RRGGBB only; FormatAccent uses uppercase hex. Stored RGB channels remain exact.",
        "textRole": "NativeAppearance.ReadableAccent(selectedRGB, actualThemeVariant)",
        "controlRole": "NativeAppearance.ControlAccent(selectedRGB)",
        "contrastMinimum": 4.5,
        "textContrastAnchors": {
          "dark": "#2D2D2D",
          "light": "#E5E5E5",
          "matrix": "#0E1B11"
        },
        "textBlendTarget": {
          "dark": "white",
          "light": "black",
          "matrix": "white"
        },
        "controlContrastBackground": "white",
        "controlBlendTarget": "black",
        "algorithm": "Keep compliant color; otherwise 20-step binary search over blend amount, with RGB channels rounded to bytes.",
        "application": "App updates Fluent palette control accents and the custom AccentBrush text shade; actual-theme changes reapply derivation. No custom override restores the original theme resource and distinct default Fluent roles."
      },
