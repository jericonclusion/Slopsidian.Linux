<Application
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:RonSijm.Slopsidian.Linux"
  x:Class="RonSijm.Slopsidian.Linux.App"
  RequestedThemeVariant="Dark"
>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="{x:Static local:NativeAppearance.GradientDark}">
          <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#252525" Offset="0" />
            <GradientStop Color="#1e1e1e" Offset="0.5" />
            <GradientStop Color="#171717" Offset="1" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#2b2b2b" Offset="0" />
            <GradientStop Color="#222222" Offset="1" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="RibbonBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#292929" Offset="0" />
            <GradientStop Color="#202020" Offset="1" />
          </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="{x:Static local:NativeAppearance.GradientLight}">
          <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#ffffff" Offset="0" />
            <GradientStop Color="#f9f9f9" Offset="0.5" />
            <GradientStop Color="#eeeeee" Offset="1" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#f5f5f5" Offset="0" />
            <GradientStop Color="#e8e8e8" Offset="1" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="RibbonBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#eeeeee" Offset="0" />
            <GradientStop Color="#e5e5e5" Offset="1" />
          </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="{x:Static local:NativeAppearance.Matrix}">
          <SolidColorBrush x:Key="TerminalSurfaceBrush">#030803</SolidColorBrush>
          <SolidColorBrush x:Key="SurfaceBrush">#030803</SolidColorBrush>
          <SolidColorBrush x:Key="SidebarBrush">#071109</SolidColorBrush>
          <SolidColorBrush x:Key="RibbonBrush">#050c07</SolidColorBrush>
          <SolidColorBrush x:Key="DividerBrush">#183820</SolidColorBrush>
          <SolidColorBrush x:Key="TextBrush">#b5f7c2</SolidColorBrush>
          <SolidColorBrush x:Key="MutedBrush">#78ba88</SolidColorBrush>
          <SolidColorBrush x:Key="AccentBrush">#00ff41</SolidColorBrush>
          <SolidColorBrush x:Key="CreateBrush">#00ff41</SolidColorBrush>
          <SolidColorBrush x:Key="AssistantActionBrush">#97e9b0</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="TerminalSurfaceBrush">#1e1e1e</SolidColorBrush>
          <SolidColorBrush x:Key="SurfaceBrush">#1e1e1e</SolidColorBrush>
          <SolidColorBrush x:Key="SidebarBrush">#262626</SolidColorBrush>
          <SolidColorBrush x:Key="RibbonBrush">#242424</SolidColorBrush>
          <SolidColorBrush x:Key="DividerBrush">#383838</SolidColorBrush>
          <SolidColorBrush x:Key="TextBrush">#dadada</SolidColorBrush>
          <SolidColorBrush x:Key="MutedBrush">#a3a3a3</SolidColorBrush>
          <SolidColorBrush x:Key="AccentBrush">#a68af9</SolidColorBrush>
          <SolidColorBrush x:Key="ErrorBrush">#f28b82</SolidColorBrush>
          <SolidColorBrush x:Key="ErrorSurfaceBrush">#3c2929</SolidColorBrush>
          <SolidColorBrush x:Key="CreateBrush">#a3d9b1</SolidColorBrush>
          <SolidColorBrush x:Key="AssistantActionBrush">#a3d9b1</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="TerminalSurfaceBrush">#ffffff</SolidColorBrush>
          <SolidColorBrush x:Key="SurfaceBrush">#ffffff</SolidColorBrush>
          <SolidColorBrush x:Key="SidebarBrush">#f2f2f2</SolidColorBrush>
          <SolidColorBrush x:Key="RibbonBrush">#e8e8e8</SolidColorBrush>
          <SolidColorBrush x:Key="DividerBrush">#d4d4d4</SolidColorBrush>
          <SolidColorBrush x:Key="TextBrush">#222222</SolidColorBrush>
          <SolidColorBrush x:Key="MutedBrush">#646464</SolidColorBrush>
          <SolidColorBrush x:Key="AccentBrush">#7051a8</SolidColorBrush>
          <SolidColorBrush x:Key="ErrorBrush">#a32e25</SolidColorBrush>
          <SolidColorBrush x:Key="ErrorSurfaceBrush">#ffebe9</SolidColorBrush>
          <SolidColorBrush x:Key="CreateBrush">#216b36</SolidColorBrush>
          <SolidColorBrush x:Key="AssistantActionBrush">#185625</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <StyleInclude Source="avares://Iciclecreek.Avalonia.Terminal/Themes/Generic.axaml" />
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#8c70c9" />
        <ColorPaletteResources x:Key="Light" Accent="#7051a8" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI, Noto Sans, sans-serif" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="7" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="Button.create">
      <Setter Property="Foreground" Value="{DynamicResource CreateBrush}" />
    </Style>
    <Style Selector="Button.dismiss">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Button.tab-close">
      <Setter Property="Padding" Value="4" />
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="MinHeight" Value="22" />
    </Style>
    <Style Selector="Button.vault-switcher">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="TabControl.sidebar-tabs TabItem">
      <Setter Property="Padding" Value="10,10" />
    </Style>
    <Style Selector="ListBox.document-tabs ListBoxItem">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,3,2,0" />
      <Setter Property="CornerRadius" Value="5,5,0,0" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="ListBox.document-tabs ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
  </Application.Styles>
</Application>
